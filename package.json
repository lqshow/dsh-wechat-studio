{
  "name": "dsh-wechat-studio",
  "version": "0.3.1",
  "description": "DeepSeek Harness 插件「公众号成稿台」：写稿、按段改稿、朱雀报告质检、公众号排版预览和一键复制。",
  "type": "module",
  "main": "src/host.js",
  "bin": {
    "wechat-studio": "./bin/wechat-studio.js"
  },
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "wechat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lqshow/dsh-wechat-studio.git"
  },
  "homepage": "https://github.com/lqshow/dsh-wechat-studio#readme",
  "license": "MIT",
  "icon": "./icon.svg",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "6.0.0",
    "unpdf": "1.4.0",
    "yauzl": "3.4.0"
  },
  "files": [
    "bin",
    "src",
    "client/xhs-card-balance.js",
    "client/xhs-card-decor.js",
    "client/xhs-card-html.js",
    "dist",
    "skills",
    "vendor",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
